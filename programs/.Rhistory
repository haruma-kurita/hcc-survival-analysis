type = "dfbetas",
ox.scale = "observation.id")
library(Hmisc)
# 6. UPDATED MODEL: FIXING LINEARITY & PROPORTIONAL HAZARDS
# 6a. Fix Linearity: Generate Restricted Cubic Splines for CXCL17P (3 knots)
# This gives the model the mathematical flexibility to follow that curved Martingale plot
splines_all <- rcspline.eval(df_clean$CXCL17P, nk = 3, inclx = TRUE)
# 6. UPDATED MODEL: FIXING LINEARITY & PROPORTIONAL HAZARDS
# 6a. Fix Linearity: Generate Restricted Cubic Splines for CXCL17P (3 knots)
# This gives the model the mathematical flexibility to follow that curved Martingale plot
splines_all <- rcspline.eval(df_clean$CXCL17P, nk = 3, inclx = TRUE)
df_clean$CXCL17P_lin <- splines_all[, 1]
df_clean$CXCL17P_nonlin <- splines_all[, 2]
# 6b. Fix Proportional Hazards: Stratify violators and refit the Cox model
# We wrap the structural covariates in strata() to push them into the baseline hazard,
# bypassing the proportional hazards assumption completely.
cox_model_fixed <- coxph(Surv(OS, Death) ~ CXCL17P_lin + CXCL17P_nonlin +
AFP + AST +
strata(Tumormultiplicity) +
strata(Tumorsize) +
strata(Vascularinvasion) +
strata(TNM) +
strata(BCLC),
data = df_clean)
summary(cox_model_fixed)
# 6c. Updated Contrast: 75th vs 25th Percentile (Spline Adjusted)
# We must push the Q1 and Q3 targets through the exact same spline knots
# so the esticon calculator knows how to subtract the curved values.
spline_q1 <- rcspline.eval(q1_cxcl, knot = attr(splines_all, "knots"), inclx = TRUE)
spline_q3 <- rcspline.eval(q3_cxcl, knot = attr(splines_all, "knots"), inclx = TRUE)
# 6. UPDATED MODEL: FIXING LINEARITY & PROPORTIONAL HAZARDS
# 6a. Fix Linearity: Generate Restricted Cubic Splines for CXCL17P (3 knots)
# using norm = 0 and extracting knots
spline_cov = rcspline.eval(df_clean$CXCL17P, nk = 3, norm = 0)
knots = attr(spline_cov, "knots")
