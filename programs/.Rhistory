)
plot_reduced = ggplot(plot_data_red, aes(x = CXCL17P, y = resid)) +
geom_point() +
geom_smooth(method = "lm",
formula = y ~ rcspline.eval(x, knots = attributes(spline5)$knots),
se = FALSE, color = "blue") +
geom_smooth(method = "lm",
formula = y ~ rcspline.eval(x, knots = attributes(spline3)$knots),
se = FALSE, color = "darkgreen") +
theme_minimal() +
geom_smooth(color = "red") +
geom_smooth(method = "lm", color = "orange", se = FALSE)
plot_reduced
# 3. Full Model Martingale Residuals (Checking for randomness about y = 0)
# Source: Module 12, Slides 11 & 19-20
martingale_resid_full <- residuals(cox_model, type = "martingale")
plot_data_full <- data.frame(
CXCL17P = hcc_clean$CXCL17P,
resid   = martingale_resid_full
)
plot_full = ggplot(plot_data_full, aes(x = CXCL17P, y = resid)) +
geom_point() +
geom_hline(yintercept = 0) +
theme_minimal() +
geom_smooth(color = "red")
plot_full
# ------------------------------------------------------------------------------
# C. Outliers Check: Deviance Residuals
# Source: Module 12, Slides 24-27
# Rule of thumb: absolute deviance residuals > 2 or 3 warrant investigation
# ------------------------------------------------------------------------------
ggcoxdiagnostics(
cox_model,
type = "deviance",
ox.scale = "linear.predictions"
)
# ------------------------------------------------------------------------------
# D. Influential Points Check: Scaled DFBETAS
# Source: Module 12, Slides 28-31
# Rule of thumb: compare against 2 / sqrt(n) using scaled "dfbetas"
# ------------------------------------------------------------------------------
ggcoxdiagnostics(
cox_model,
type = "dfbetas",
ox.scale = "observation.id"
)
# 1. SETUP & DATA PREPARATION
library(survival)
library(survminer)
library(doBy)
library(asaur)
library(dplyr)
data("hepatoCellular")
# Data Cleaning
df_clean <- hepatoCellular |>
select(OS, Death, CXCL17P, Tumormultiplicity, AFP, AST, Tumorsize, Vascularinvasion, TNM, BCLC) |>
na.omit()
# Convert clinical covariates to factors (reference cell coding)
df_clean <- df_clean %>%
mutate(across(c(Tumormultiplicity, AFP, AST, Tumorsize, Vascularinvasion, TNM, BCLC), as.factor))
summary(df_clean)
# Get IQR specifically for CXCL17P
q1_cxcl <- quantile(df_clean$CXCL17P, 0.25)
q3_cxcl <- quantile(df_clean$CXCL17P, 0.75)
# 2. AIM 1: MULTIVARIABLE COX MODEL
# Fit the multivariable Cox proportional hazards model
cox_model <- coxph(Surv(df_clean$OS, df_clean$Death) ~ CXCL17P + Tumormultiplicity + AFP + AST + Tumorsize +
Vascularinvasion + TNM + BCLC, data = df_clean)
summary(cox_model)
# 3. CONTRAST: 75th vs 25th Percentile of CXCL17P
L_matrix <- rbind(c(q3_cxcl - q1_cxcl, 0, 0, 0, 0, 0, 0, 0))
# Calculate and print the contrast estimate, CI, and p-value
cxcl_contrast <- esticon(cox_model, L_matrix, conf.int = TRUE)
print(cxcl_contrast)
# Print exponentiated Hazard Ratio and CI for interpretation
paste0("Hazard Ratio for 75th vs 25th Percentile: ",
round(exp(cxcl_contrast$estimate), 2), " (",
round(exp(cxcl_contrast$lwr), 2), ", ",
round(exp(cxcl_contrast$upr), 2), ")")
# 4. VISUAL: ADJUSTED SURVIVAL CURVES (Average Patient Approach)
# Create a new dataset setting CXCL17P to Q1 and Q3, while holding other covariates constant
# at their reference levels (e.g., "1" or "0") to isolate the effect of CXCL17P.
new_data_plot <- data.frame(
CXCL17P = c(q1_cxcl, q3_cxcl),
Tumormultiplicity = factor(c(1, 1), levels = levels(df_clean$Tumormultiplicity)),
AFP = factor(c(1, 1), levels = levels(df_clean$AFP)),
AST = factor(c(1, 1), levels = levels(df_clean$AST)),
Tumorsize = factor(c(1, 1), levels = levels(df_clean$Tumorsize)),
Vascularinvasion = factor(c(0, 0), levels = levels(df_clean$Vascularinvasion)),
TNM = factor(c(1, 1), levels = levels(df_clean$TNM)),
BCLC = factor(c(1, 1), levels = levels(df_clean$BCLC))
)
# Estimate survival for these specific profiles
surv_avg <- survfit(cox_model, newdata = new_data_plot)
# Plot the adjusted curves
ggsurvplot(surv_avg, data = new_data_plot,
legend.title = "CXCL17P Percentile",
legend.labs = c("25th Percentile", "75th Percentile"))
# 5. DIAGNOSTICS & ASSUMPTIONS
# 5a. Proportional Hazards: Scaled Schoenfeld Residuals
ph_test <- cox.zph(cox_model)
print(ph_test)
ggcoxzph(ph_test)
# 5b. Linearity of Continuous Predictor: Null Martingale Residuals
# Note: ggcoxfunctional runs the null model internally and plots against the continuous covariate.
ggcoxfunctional(Surv(OS, Death) ~ CXCL17P, data = df_clean)
# 5c. Outliers: Deviance Residuals
# We look for points with absolute deviance residuals > 2 or 3.
ggcoxdiagnostics(cox_model,
type = "deviance",
ox.scale = "linear.predictions")[cite: 39]
# 5c. Outliers: Deviance Residuals
# We look for points with absolute deviance residuals > 2 or 3.
ggcoxdiagnostics(cox_model,
type = "deviance",
ox.scale = "linear.predictions")
# 5d. Influential Points: DFBETAS
# We look for deviations of specific points from 0 to see how removing an observation affects coefficients[cite: 43, 44].
ggcoxdiagnostics(cox_model,
type = "dfbetas",
ox.scale = "observation.id")
# 5b. Linearity of Continuous Predictor: Null Martingale Residuals
# Note: ggcoxfunctional runs the null model internally and plots against the continuous covariate.
ggcoxfunctional(Surv(OS, Death) ~ CXCL17P, data = df_clean)
# 5c. Outliers: Deviance Residuals
# We look for points with absolute deviance residuals > 2 or 3.
ggcoxdiagnostics(cox_model,
type = "deviance",
ox.scale = "linear.predictions")
# 5d. Influential Points: DFBETAS
# We look for deviations of specific points from 0 to see how removing an observation affects coefficients.
ggcoxdiagnostics(cox_model,
type = "dfbetas",
ox.scale = "observation.id")
