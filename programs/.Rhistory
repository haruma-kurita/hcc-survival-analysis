data(hepatoCellular)
hcc_clean <- hepatoCellular %>%
# Select only the variables required for Aim 1
select(OS, Death, CXCL17P, Tumormultiplicity, AFP, AST,
Tumorsize, Vascularinvasion, TNM, BCLC) %>%
# Handle missing data via complete-case analysis
na.omit() %>%
# Convert categorical clinical covariates to factors for dummy coding
mutate(
Tumormultiplicity = factor(Tumormultiplicity),
AFP               = factor(AFP),
AST               = factor(AST),
Tumorsize         = factor(Tumorsize),
Vascularinvasion  = factor(Vascularinvasion),
TNM               = factor(TNM),
BCLC              = factor(BCLC)
)
# 3. Descriptive Summaries for CXCL17P Contrast Levels
# Calculate the 25th and 75th percentiles (IQR) for CXCL17P
cxcl17p_quantiles <- quantile(hcc_clean$CXCL17P, probs = c(0.25, 0.75))
p25 <- cxcl17p_quantiles[1]
p75 <- cxcl17p_quantiles[2]
cat("25th Percentile of CXCL17P:", p25, "\n")
cat("75th Percentile of CXCL17P:", p75, "\n")
# 4. Fit the Multivariable Cox Proportional Hazards Model
cox_model <- coxph(
Surv(OS, Death) ~ CXCL17P + Tumormultiplicity + AFP + AST +
Tumorsize + Vascularinvasion + TNM + BCLC,
data = hcc_clean
)
summary(cox_model)
# 1. Load Required Libraries
library(survival)
library(survminer)
library(asaur)
library(dplyr)
library(ggplot2)
library(doBy)
library(Hmisc)
data("hepatoCellular")
hcc_clean = hepatoCellular |>
select(OS, Death, CXCL17P, Tumormultiplicity, AFP, AST,
Tumorsize, Vascularinvasion, TNM, BCLC) |>
na.omit() |>
# default reference cell / dummy coding in R)
mutate(
Tumormultiplicity = factor(Tumormultiplicity), # 1 = Solitary (Ref), 2 = Multiple
AFP               = factor(AFP),               # 1 = <=25 (Ref), 2 = >25
AST               = factor(AST),               # 1 = <=42 (Ref), 2 = >42
Tumorsize         = factor(Tumorsize),         # 1 = <=5cm (Ref), 2 = >5cm
Vascularinvasion  = factor(Vascularinvasion),  # 0 = Absent (Ref), 1 = Present
TNM               = factor(TNM),               # 1 = I+II (Ref), 2 = III+IV
BCLC              = factor(BCLC)               # 1 = 0-A (Ref), 2 = B-C
)
# Create the Survival Object
surv_obj_hcc = Surv(hcc_clean$OS, hcc_clean$Death)
cox_model = coxph(
surv_obj_hcc ~ CXCL17P + Tumormultiplicity + AFP + AST + Tumorsize +
Vascularinvasion + TNM + BCLC,
data = hcc_clean,
x = TRUE # Stores the data matrix; required for post-hoc testing (like esticon/cox.zph)
)
summary(cox_model)
# Output Harrell's C Index (Concordance)
concordance(cox_model)
cxcl17p_quantiles = quantile(hcc_clean$CXCL17P, probs = c(0.25, 0.75))
p25 = as.numeric(cxcl17p_quantiles[1])
p75 = as.numeric(cxcl17p_quantiles[2])
delta = p75 - p25
# Create the L matrix for linear combination l^T * beta
# CXCL17P is the 1st coefficient (weighted by delta); the 7 confounders are set to 0
L = rbind(
c(delta, 0, 0, 0, 0, 0, 0, 0)
)
# Run the contrast using esticon()
cxcl17p_75_v_25 = esticon(cox_model, L, conf.int = TRUE)
# Output raw contrast table (provides estimate, std.error, statistic, and p.value)
cxcl17p_75_v_25
# Output log-hazard 95% confidence interval bounds
c(cxcl17p_75_v_25$lwr, cxcl17p_75_v_25$upr)
# Exponentiate to get the Hazard Ratio and 95% CI for the 75th vs 25th percentile
paste0("Hazard Ratio for CXCL17P (75th vs 25th Percentile): ",
round(exp(cxcl17p_75_v_25$estimate), 2), " (",
round(exp(cxcl17p_75_v_25$lwr), 2), ", ",
round(exp(cxcl17p_75_v_25$upr), 2), "), p-value = ",
signif(cxcl17p_75_v_25$p.value, 3))
hcc_trick = hcc_clean %>%
mutate(CXCL17P = c(p25, rep(p75, nrow(hcc_clean) - 1)))
ggadjustedcurves(
cox_model,
variable = "CXCL17P",
data = hcc_trick
) +
labs(title = "Direct Adjusted Survival: 75th vs 25th Percentile of CXCL17P",
x = "Time (Months)",
y = "Survival Rate",
color = "CXCL17P Percentile")
hcc_trick = hcc_clean %>%
mutate(CXCL17P = c(p25, rep(p75, nrow(hcc_clean) - 1)))
ggadjustedcurves(
cox_model,
variable = "CXCL17P",
data = hcc_trick
) +
labs(title = "Direct Adjusted Survival: 75th vs 25th Percentile of CXCL17P",
x = "Time (Months)",
y = "Survival Rate",
color = "CXCL17P Percentile")
# ------------------------------------------------------------------------------
# A. Proportional Hazards (PH) Assumption: Scaled Schoenfeld Residuals
# ------------------------------------------------------------------------------
# Formal hypothesis test and Schoenfeld residual plots for all predictors
cox.zph(cox_model)
ggcoxzph(cox.zph(cox_model))
# Complementary Log-Log Plot (Visual check for categorical covariates, e.g., AFP)
surv_plot_afp = ggsurvplot(survfit(surv_obj_hcc ~ AFP, data = hcc_clean),
data = hcc_clean)
ggplot(data = surv_plot_afp$data.survplot,
aes(log(time), log(-log(surv)), color = AFP)) +
geom_point() +
geom_path() +
labs(title = "Complementary Log-Log Plot for AFP")
# 1. Null Martingale Residuals using ggcoxfunctional()
ggcoxfunctional(surv_obj_hcc ~ CXCL17P, ylim = c(-1, 1), data = hcc_clean)
# ------------------------------------------------------------------------------
# A. Proportional Hazards (PH) Assumption: Scaled Schoenfeld Residuals
# Source: Module 11, Slides 18-20 & 23; Module 12, Slides 5 & 7
# ------------------------------------------------------------------------------
# Formal hypothesis test and Schoenfeld residual plots for all predictors
cox.zph(cox_model)
ggcoxzph(cox.zph(cox_model))
ggcoxzph(cox.zph(cox_model))
# Complementary Log-Log Plot (Visual check for categorical covariates, e.g., AFP)
# Source: Module 11, Slides 10, 13-14, & 22
surv_plot_afp = ggsurvplot(survfit(surv_obj_hcc ~ AFP, data = hcc_clean),
data = hcc_clean)
ggplot(data = surv_plot_afp$data.survplot,
aes(log(time), log(-log(surv)), color = AFP)) +
geom_point() +
geom_path() +
labs(title = "Complementary Log-Log Plot for AFP")
# 1. Null Martingale Residuals using ggcoxfunctional()
# Source: Module 12, Slides 11, 13, & 14
ggcoxfunctional(surv_obj_hcc ~ CXCL17P, ylim = c(-1, 1), data = hcc_clean)
# 2. Martingale Residuals without CXCL17P (Reduced Model + Spline Overlays)
# Source: Module 12, Slides 11 & 17-18
cox_reduced <- coxph(
surv_obj_hcc ~ Tumormultiplicity + AFP + AST +
Tumorsize + Vascularinvasion + TNM + BCLC,
data = hcc_clean
)
martingale_resid_red <- residuals(cox_reduced, type = "martingale")
spline5 <- rcspline.eval(hcc_clean$CXCL17P, nk = 5, inclx = TRUE)
spline3 <- rcspline.eval(hcc_clean$CXCL17P, nk = 3, inclx = TRUE)
plot_data_red <- data.frame(
CXCL17P = hcc_clean$CXCL17P,
resid   = martingale_resid_red,
spline5 = spline5,
spline3 = spline3
)
plot_reduced = ggplot(plot_data_red, aes(x = CXCL17P, y = resid)) +
geom_point() +
geom_smooth(method = "lm",
formula = y ~ rcspline.eval(x, knots = attributes(spline5)$knots),
se = FALSE, color = "blue") +
geom_smooth(method = "lm",
formula = y ~ rcspline.eval(x, knots = attributes(spline3)$knots),
se = FALSE, color = "darkgreen") +
theme_minimal() +
geom_smooth(color = "red") +
geom_smooth(method = "lm", color = "orange", se = FALSE)
plot_reduced
# 3. Full Model Martingale Residuals (Checking for randomness about y = 0)
# Source: Module 12, Slides 11 & 19-20
martingale_resid_full <- residuals(cox_model, type = "martingale")
plot_data_full <- data.frame(
CXCL17P = hcc_clean$CXCL17P,
resid   = martingale_resid_full
)
plot_full = ggplot(plot_data_full, aes(x = CXCL17P, y = resid)) +
geom_point() +
geom_hline(yintercept = 0) +
theme_minimal() +
geom_smooth(color = "red")
plot_full
# ------------------------------------------------------------------------------
# C. Outliers Check: Deviance Residuals
# Source: Module 12, Slides 24-27
# Rule of thumb: absolute deviance residuals > 2 or 3 warrant investigation
# ------------------------------------------------------------------------------
ggcoxdiagnostics(
cox_model,
type = "deviance",
ox.scale = "linear.predictions"
)
# ------------------------------------------------------------------------------
# D. Influential Points Check: Scaled DFBETAS
# Source: Module 12, Slides 28-31
# Rule of thumb: compare against 2 / sqrt(n) using scaled "dfbetas"
# ------------------------------------------------------------------------------
ggcoxdiagnostics(
cox_model,
type = "dfbetas",
ox.scale = "observation.id"
)
# 1. SETUP & DATA PREPARATION
library(survival)
library(survminer)
library(doBy)
library(asaur)
library(dplyr)
data("hepatoCellular")
# Data Cleaning
df_clean <- hepatoCellular |>
select(OS, Death, CXCL17P, Tumormultiplicity, AFP, AST, Tumorsize, Vascularinvasion, TNM, BCLC) |>
na.omit()
# Convert clinical covariates to factors (reference cell coding)
df_clean <- df_clean %>%
mutate(across(c(Tumormultiplicity, AFP, AST, Tumorsize, Vascularinvasion, TNM, BCLC), as.factor))
summary(df_clean)
# Get IQR specifically for CXCL17P
q1_cxcl <- quantile(df_clean$CXCL17P, 0.25)
q3_cxcl <- quantile(df_clean$CXCL17P, 0.75)
# 2. AIM 1: MULTIVARIABLE COX MODEL
# Fit the multivariable Cox proportional hazards model
cox_model <- coxph(Surv(df_clean$OS, df_clean$Death) ~ CXCL17P + Tumormultiplicity + AFP + AST + Tumorsize +
Vascularinvasion + TNM + BCLC, data = df_clean)
summary(cox_model)
# 3. CONTRAST: 75th vs 25th Percentile of CXCL17P
L_matrix <- rbind(c(q3_cxcl - q1_cxcl, 0, 0, 0, 0, 0, 0, 0))
# Calculate and print the contrast estimate, CI, and p-value
cxcl_contrast <- esticon(cox_model, L_matrix, conf.int = TRUE)
print(cxcl_contrast)
# Print exponentiated Hazard Ratio and CI for interpretation
paste0("Hazard Ratio for 75th vs 25th Percentile: ",
round(exp(cxcl_contrast$estimate), 2), " (",
round(exp(cxcl_contrast$lwr), 2), ", ",
round(exp(cxcl_contrast$upr), 2), ")")
# 4. VISUAL: ADJUSTED SURVIVAL CURVES (Average Patient Approach)
# Create a new dataset setting CXCL17P to Q1 and Q3, while holding other covariates constant
# at their reference levels (e.g., "1" or "0") to isolate the effect of CXCL17P.
new_data_plot <- data.frame(
CXCL17P = c(q1_cxcl, q3_cxcl),
Tumormultiplicity = factor(c(1, 1), levels = levels(df_clean$Tumormultiplicity)),
AFP = factor(c(1, 1), levels = levels(df_clean$AFP)),
AST = factor(c(1, 1), levels = levels(df_clean$AST)),
Tumorsize = factor(c(1, 1), levels = levels(df_clean$Tumorsize)),
Vascularinvasion = factor(c(0, 0), levels = levels(df_clean$Vascularinvasion)),
TNM = factor(c(1, 1), levels = levels(df_clean$TNM)),
BCLC = factor(c(1, 1), levels = levels(df_clean$BCLC))
)
# Estimate survival for these specific profiles
surv_avg <- survfit(cox_model, newdata = new_data_plot)
# Plot the adjusted curves
ggsurvplot(surv_avg, data = new_data_plot,
legend.title = "CXCL17P Percentile",
legend.labs = c("25th Percentile", "75th Percentile"))
# 5. DIAGNOSTICS & ASSUMPTIONS
# 5a. Proportional Hazards: Scaled Schoenfeld Residuals
ph_test <- cox.zph(cox_model)
print(ph_test)
ggcoxzph(ph_test)
# 5b. Linearity of Continuous Predictor: Null Martingale Residuals
# Note: ggcoxfunctional runs the null model internally and plots against the continuous covariate.
ggcoxfunctional(Surv(OS, Death) ~ CXCL17P, data = df_clean)
# 5c. Outliers: Deviance Residuals
# We look for points with absolute deviance residuals > 2 or 3.
ggcoxdiagnostics(cox_model,
type = "deviance",
ox.scale = "linear.predictions")[cite: 39]
# 5c. Outliers: Deviance Residuals
# We look for points with absolute deviance residuals > 2 or 3.
ggcoxdiagnostics(cox_model,
type = "deviance",
ox.scale = "linear.predictions")
# 5d. Influential Points: DFBETAS
# We look for deviations of specific points from 0 to see how removing an observation affects coefficients[cite: 43, 44].
ggcoxdiagnostics(cox_model,
type = "dfbetas",
ox.scale = "observation.id")
# 5b. Linearity of Continuous Predictor: Null Martingale Residuals
# Note: ggcoxfunctional runs the null model internally and plots against the continuous covariate.
ggcoxfunctional(Surv(OS, Death) ~ CXCL17P, data = df_clean)
# 5c. Outliers: Deviance Residuals
# We look for points with absolute deviance residuals > 2 or 3.
ggcoxdiagnostics(cox_model,
type = "deviance",
ox.scale = "linear.predictions")
# 5d. Influential Points: DFBETAS
# We look for deviations of specific points from 0 to see how removing an observation affects coefficients.
ggcoxdiagnostics(cox_model,
type = "dfbetas",
ox.scale = "observation.id")
