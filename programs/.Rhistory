# 1. Load Required Libraries
library(survival)
library(survminer)
library(asaur)
library(doBy)      # For esticon() contrasts
library(dplyr)     # For data manipulation
# 2. Data Preparation and Cleaning (Complete-Case Analysis)
data(hepatoCellular)
hcc_clean <- hepatoCellular %>%
# Select only the variables required for Aim 1
select(OS, Death, CXCL17P, Tumormultiplicity, AFP, AST,
Tumorsize, Vascularinvasion, TNM, BCLC) %>%
# Handle missing data via complete-case analysis
na.omit() %>%
# Convert categorical clinical covariates to factors for dummy coding
mutate(
Tumormultiplicity = factor(Tumormultiplicity),
AFP               = factor(AFP),
AST               = factor(AST),
Tumorsize         = factor(Tumorsize),
Vascularinvasion  = factor(Vascularinvasion),
TNM               = factor(TNM),
BCLC              = factor(BCLC)
)
# 3. Descriptive Summaries for CXCL17P Contrast Levels
# Calculate the 25th and 75th percentiles (IQR) for CXCL17P
cxcl17p_quantiles <- quantile(hcc_clean$CXCL17P, probs = c(0.25, 0.75))
p25 <- cxcl17p_quantiles[1]
p75 <- cxcl17p_quantiles[2]
cat("25th Percentile of CXCL17P:", p25, "\n")
cat("75th Percentile of CXCL17P:", p75, "\n")
# 4. Fit the Multivariable Cox Proportional Hazards Model
cox_model <- coxph(
Surv(OS, Death) ~ CXCL17P + Tumormultiplicity + AFP + AST +
Tumorsize + Vascularinvasion + TNM + BCLC,
data = hcc_clean
)
summary(cox_model)
# 5. Calculate the Contrast (75th vs 25th Percentile) using esticon()
# We want the hazard ratio for a jump from the 25th to the 75th percentile.
delta <- p75 - p25
# Create the contrast matrix 'L'.
# CXCL17P is the 1st coefficient; the other 7 factor coefficients are set to 0.
L_matrix <- c(delta, 0, 0, 0, 0, 0, 0, 0)
# Run esticon to get the estimate, standard error, and confidence intervals
contrast_res <- esticon(cox_model, L = L_matrix)
# Exponentiate to get the Hazard Ratio and 95% CIs for the specific contrast
contrast_hr <- exp(contrast_res$Estimate)
# Create the contrast matrix 'L'.
# CXCL17P is the 1st coefficient; the other 7 factor coefficients are set to 0.
L_matrix <- c(delta, 0, 0, 0, 0, 0, 0, 0)
# Run esticon to get the estimate, standard error, and confidence intervals
contrast_res <- esticon(cox_model, L = L_matrix)
# Exponentiate to get the Hazard Ratio and 95% CIs for the specific contrast
contrast_hr <- exp(contrast_res$Estimate)
contrast_lower <- exp(contrast_res$Lower)
contrast_upper <- exp(contrast_res$Upper)
cat("Contrast HR (75th vs 25th Percentile):", contrast_hr,
"\n95% CI: [", contrast_lower, "-", contrast_upper, "]\n")
# 4. Fit the Multivariable Cox Proportional Hazards Model
cox_model <- coxph(
Surv(OS, Death) ~ CXCL17P + Tumormultiplicity + AFP + AST +
Tumorsize + Vascularinvasion + TNM + BCLC,
data = hcc_clean
)
summary(cox_model)
# 4. Fit the Multivariable Cox Proportional Hazards Model
cox_model <- coxph(
Surv(OS, Death) ~ CXCL17P + Tumormultiplicity + AFP + AST +
Tumorsize + Vascularinvasion + TNM + BCLC,
data = hcc_clean
)
